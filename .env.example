
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LLM_URL: OpenAI-compatible base URL for the chat model (e.g. https://api.deepseek.com/v1).
# LLM_KEY: Bearer token for the LLM. Set in Vercel environment variables only; never committed.
# LLM_MODEL: Model name served by the LLM (e.g. deepseek-chat). No hardcoded default.
LLM_URL=""
LLM_KEY=""
LLM_MODEL=""
